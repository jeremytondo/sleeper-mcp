{
  "name": "sleeper-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Read-only Sleeper draft context over Streamable HTTP MCP",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/src/index.js",
    "test": "node --import tsx --test 'test/**/*.test.ts'",
    "test:integration": "RUN_NETWORK_TESTS=1 node --import tsx --test test/server.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "express": "^5.1.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
